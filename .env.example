# ============================
# AUTH OPTION 1: API Key
# ============================
# Get your key at https://onboarding.eigencloud.xyz/
# EIGENAI_API_KEY=your-eigenai-api-key
# EIGENAI_BASE_URL=https://eigenai.eigencloud.xyz/v1

# ============================
# AUTH OPTION 2: deTERMinal Grant (Free 1M tokens)
# ============================
# Step 1: Go to https://determinal.eigenarcade.com and connect your X account
# Step 2: Get your signing challenge:
#   curl "https://determinal-api.eigenarcade.com/message?address=YOUR_WALLET_ADDRESS"
# Step 3: Sign the message with your wallet and fill in below:
# EIGENAI_GRANT_WALLET_ADDRESS=0xYourWalletAddress
# EIGENAI_GRANT_MESSAGE=the-challenge-message-from-step-2
# EIGENAI_GRANT_SIGNATURE=your-signed-message
# EIGENAI_GRANT_API_URL=https://determinal-api.eigenarcade.com

# ============================
# Model (same for both auth modes)
# ============================
EIGENAI_MODEL=gpt-oss-120b-f16

# Server Configuration
PORT=8000
NODE_ENV=production
MAX_UPLOAD_SIZE_MB=50

# TEE Configuration (auto-generated by EigenCompute)
# MNEMONIC=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=20
