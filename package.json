{
  "name": "private-code-reviewer",
  "version": "1.0.0",
  "description": "Private code reviewer running inside EigenCompute TEE — reviews code for backdoors and rug-pull functionality while keeping the codebase completely confidential",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "dev:all": "concurrently \"npm run dev\" \"cd frontend && npm run dev\"",
    "docker:build": "docker build --platform linux/amd64 -t private-code-reviewer .",
    "docker:run": "docker run --rm --env-file .env -p 8000:8000 private-code-reviewer",
    "deploy": "ecloud compute app deploy"
  },
  "dependencies": {
    "express": "^4.21.0",
    "multer": "^1.4.5-lts.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "uuid": "^9.0.0",
    "archiver": "^7.0.0",
    "extract-zip": "^2.0.1",
    "tar": "^7.4.0",
    "openai": "^4.68.0",
    "pdfkit": "^0.15.0",
    "dotenv": "^16.4.5",
    "express-rate-limit": "^7.4.0",
    "winston": "^3.14.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/cors": "^2.8.17",
    "@types/uuid": "^9.0.8",
    "@types/archiver": "^6.0.2",
    "@types/pdfkit": "^0.13.4",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0",
    "tsx": "^4.19.0",
    "concurrently": "^9.0.0"
  }
}
